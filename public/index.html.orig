<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Nexus AI - Your local AI workspace assistant"
    >

    <title>Nexus AI</title>

    <link
        rel="stylesheet"
        href="style.css"
    >
</head>

<body>

<div class="app">

    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="sidebar">

        <div class="sidebar-header">

            <div class="brand">
                <div class="brand-icon">N</div>

                <div class="brand-text">
                    Nexus AI
                </div>
            </div>

            <button
                id="newChatButton"
                class="new-chat-button"
                type="button"
                title="New Chat"
            >
                <span class="new-chat-icon">+</span>
                <span>New Chat</span>
            </button>

        </div>


        <div class="search-container">

            <div class="search-box">

                <span class="search-icon">⌕</span>

                <input
                    id="searchInput"
                    type="text"
                    placeholder="Search chats..."
                    autocomplete="off"
                >

            </div>

        </div>

        <nav class="sidebar-navigation" aria-label="Nexus sections">
            <button class="sidebar-nav-item" data-view="projects" type="button">
                <span class="sidebar-nav-icon">▣</span>
                <span>Projects</span>
            </button>
            <button class="sidebar-nav-item" data-view="scheduled" type="button">
                <span class="sidebar-nav-icon">◷</span>
                <span>Scheduled</span>
            </button>
            <button class="sidebar-nav-item" data-view="plugins" type="button">
                <span class="sidebar-nav-icon">⊞</span>
                <span>Plugins</span>
            </button>
            <button class="sidebar-nav-item" data-view="library" type="button">
                <span class="sidebar-nav-icon">▥</span>
                <span>Library</span>
            </button>
            <button class="sidebar-nav-item" data-view="images" type="button">
                <span class="sidebar-nav-icon">▧</span>
                <span>Images</span>
            </button>
        </nav>


        <div class="conversation-section">

            <div class="conversation-section-title">
                Chats
            </div>

            <div
                id="conversationList"
                class="conversation-list"
            ></div>

        </div>


        <div class="sidebar-footer">

            <button
                id="accountSettingsButton"
                class="sidebar-footer-item"
                type="button"
                title="Settings and account"
            >

                <div class="footer-avatar">
                    N
                </div>

                <div class="footer-info">

                    <div class="footer-name">
                        Nexus AI
                    </div>

                    <div class="footer-status">
                        Local Assistant
                    </div>

                </div>

            </button>

        </div>

    </aside>


    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="main-content">

        <header class="chat-header">

            <div class="chat-header-left">

                <button
                    id="sidebarToggle"
                    class="header-icon-button sidebar-toggle"
                    type="button"
                    title="Toggle sidebar"
                    aria-label="Toggle sidebar"
                    aria-expanded="true"
                >
                    ☰
                </button>

                <div
                    id="chatTitle"
                    class="chat-title"
                >
                    Nexus AI
                </div>

                <nav class="mode-tabs" aria-label="Conversation mode">
                    <button class="mode-tab active" data-mode="chat" type="button">Chat</button>
                    <button class="mode-tab" data-mode="work" type="button">Work</button>
                </nav>

            </div>


        </header>


        <div class="workspace-layout">

            <!-- =================================================
                 CHAT
            ================================================== -->

            <section class="chat-panel">

                <section
                    id="messages"
                    class="messages"
                ></section>


                <div class="input-area">

                    <div class="input-wrapper">

                        <textarea
                            id="messageInput"
                            rows="1"
                            placeholder="Message Nexus AI..."
                            autocomplete="off"
                            spellcheck="true"
                        ></textarea>

                        <div class="composer-toolbar">
                            <div class="composer-tools">
                                <button
                                    id="attachmentButton"
                                    class="composer-icon-button"
                                    type="button"
                                    title="Add files"
                                    aria-label="Add files"
                                >+</button>
                                <input
                                    id="attachmentInput"
                                    type="file"
                                    hidden
                                    multiple
                                >
                                <button
                                    id="toolsButton"
                                    class="composer-tool-button"
                                    type="button"
                                    aria-expanded="false"
                                >Tools</button>
                                <button
                                    id="thinkButton"
                                    class="composer-tool-button"
                                    type="button"
                                    aria-pressed="false"
                                    title="Use deeper reasoning"
                                >Think</button>
                                <button
                                    id="webSearchButton"
                                    class="composer-tool-button"
                                    type="button"
                                    aria-pressed="false"
                                    title="Search the web"
                                >Search web</button>
                                <button
                                    id="imageButton"
                                    class="composer-tool-button"
                                    type="button"
                                    title="Create an image"
                                >Image</button>
                            </div>
                            <div class="composer-controls">
                                <label
                                    class="sr-only"
                                    for="modelSelector"
                                >Model</label>
                                <select
                                    id="modelSelector"
                                    class="composer-select"
                                    aria-label="Select model role"
                                >
                                    <option value="chat">Chat</option>
                                </select>
                                <label
                                    class="sr-only"
                                    for="intelligenceSelector"
                                >Intelligence</label>
                                <select
                                    id="intelligenceSelector"
                                    class="composer-select intelligence-selector"
                                    aria-label="Select intelligence level"
                                >
                                    <option value="auto">Auto</option>
                                    <option value="fast">Fast</option>
                                    <option value="balanced" selected>Balanced</option>
                                    <option value="high">High</option>
                                    <option value="very-high">Very High</option>
                                    <option value="maximum">Maximum</option>
                                    <option value="expert">Expert</option>
                                </select>
                                <button
                                    id="voiceButton"
                                    class="composer-icon-button voice-button"
                                    type="button"
                                    title="Start voice chat"
                                    aria-label="Start voice chat"
                                >◉</button>
                            </div>
                        </div>

                        <button
                            id="sendButton"
                            class="send-button"
                            type="button"
                            title="Send message"
                        >

                            <span class="send-button-text">
                                Send
                            </span>

                            <span class="send-button-icon">
                                ↑
                            </span>

                        </button>

                    </div>


                    <div class="input-hint">

                        <span>Enter</span> to send

                        <span class="hint-separator">
                            •
                        </span>

                        <span>Shift + Enter</span>
                        for a new line

                    </div>

                </div>

            </section>


            <!-- =================================================
                 WORKSPACE
            ================================================== -->

            <aside
                id="workspacePanel"
                class="workspace-panel"
                hidden
            >

                <div class="workspace-header">

                    <div>

                        <div class="workspace-title">
                            Artifacts & workspace
                        </div>

                        <div
                            id="workspaceSubtitle"
                            class="workspace-subtitle"
                        >
                            C:\NexusAI\workspace
                        </div>

                    </div>

                    <button
                        id="workspaceClose"
                        class="workspace-close"
                        type="button"
                        title="Close workspace"
                    >
                        ×
                    </button>

                </div>

                <nav class="workspace-tabs" aria-label="Workspace sections">
                    <button
                        type="button"
                        class="workspace-tab active"
                        data-workspace-section="activity"
                    >Activity</button>
                    <button
                        type="button"
                        class="workspace-tab"
                        data-workspace-section="files"
                    >Files</button>
                    <button
                        type="button"
                        class="workspace-tab"
                        data-workspace-section="preview"
                    >Preview</button>
                </nav>


                <!-- Agent activity -->

                <section
                    id="workspaceActivitySection"
                    class="workspace-section"
                >

                    <div class="workspace-section-header">

                        <span>
                            Agent Activity
                        </span>

                        <span
                            id="activityState"
                            class="activity-state"
                        >
                            Ready
                        </span>

                    </div>


                    <div
                        id="agentActivity"
                        class="agent-activity"
                    >

                        <div class="activity-empty">
                            Nexus activity will appear here when it works on your project.
                        </div>

                    </div>

                </section>


                <!-- Project -->

                <section class="workspace-section">

                    <div class="workspace-section-header">

                        <span>
                            Project
                        </span>

                        <button
                            id="refreshWorkspace"
                            class="small-action-button"
                            type="button"
                            title="Refresh workspace"
                        >
                            ↻
                        </button>

                    </div>


                    <div
                        id="projectInfo"
                        class="project-info"
                    >

                        <div class="project-empty">
                            No project detected yet.
                        </div>

                    </div>

                </section>


                <!-- Files -->

                <section
                    id="workspaceFilesSection"
                    class="workspace-section workspace-files-section"
                >

                    <div class="workspace-section-header">

                        <span>
                            Files
                        </span>

                        <span
                            id="fileCount"
                            class="file-count"
                        >
                            0
                        </span>

                    </div>


                    <div
                        id="workspaceTree"
                        class="workspace-tree"
                    >

                        <div class="tree-empty">
                            Workspace is empty.
                        </div>

                    </div>

                </section>


                <!-- Selected file -->

                <section
                    id="fileEditorSection"
                    class="workspace-section file-editor-section hidden"
                >

                    <div class="workspace-section-header">

                        <span
                            id="selectedFileName"
                        >
                            File
                        </span>

                        <div class="editor-actions">

                            <button
                                id="saveFileButton"
                                class="small-action-button"
                                type="button"
                            >
                                Save
                            </button>

                            <button
                                id="closeFileButton"
                                class="small-action-button"
                                type="button"
                            >
                                ×
                            </button>

                        </div>

                    </div>


                    <textarea
                        id="fileEditor"
                        class="file-editor"
                        spellcheck="false"
                    ></textarea>

                </section>


                <!-- Preview -->

                <section
                    id="workspacePreviewSection"
                    class="workspace-section preview-section"
                >

                    <div class="workspace-section-header">

                        <span>
                            Live Preview
                        </span>

                        <div class="preview-actions">

                            <button
                                id="openPreviewButton"
                                class="small-action-button"
                                type="button"
                            >
                                Open
                            </button>

                            <button
                                id="refreshPreviewButton"
                                class="small-action-button"
                                type="button"
                            >
                                ↻
                            </button>

                        </div>

                    </div>


                    <div
                        id="previewContainer"
                        class="preview-container"
                    >

                        <div class="preview-placeholder">

                            <div class="preview-icon">
                                ◇
                            </div>

                            <div class="preview-title">
                                No preview yet
                            </div>

                            <div class="preview-description">
                                Create a website project and Nexus will make it available here.
                            </div>

                        </div>

                    </div>

                </section>


                <!-- Verification -->

                <section class="workspace-section">

                    <div class="workspace-section-header">
                        <span>
                            Verification
                        </span>
                    </div>


                    <div
                        id="verificationPanel"
                        class="verification-panel"
                    >

                        <div class="verification-empty">
                            Nothing verified yet.
                        </div>

                    </div>

                </section>

            </aside>

        </div>

    </main>

</div>


<!-- =========================================================
     CONTROL CENTER
========================================================= -->

<div
    id="controlCenterModal"
    class="modal-overlay"
    aria-hidden="true"
>

    <div
        class="control-center-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="controlCenterTitle"
    >

        <div class="rename-modal-header">

            <div>
                <div
                    id="controlCenterTitle"
                    class="rename-modal-title"
                >
                    Settings
                </div>

                <div class="rename-modal-subtitle">
                    Account, appearance, models, integrations, permissions, and runtime health.
                </div>
            </div>

            <button
                type="button"
                class="modal-close-button"
                data-action="close-control-center"
                aria-label="Close"
            >
                ×
            </button>

        </div>

        <div
            id="controlCenterBody"
            class="control-center-body"
        >
            <div class="capability-loading">Loading capabilities...</div>
        </div>

        <div class="rename-modal-footer">
            <button
                type="button"
                class="modal-button secondary"
                data-action="close-control-center"
            >
                Close
            </button>
        </div>

    </div>

</div>


<!-- =========================================================
     RENAME MODAL
========================================================= -->

<div
    id="renameModal"
    class="modal-overlay"
    aria-hidden="true"
>

    <div
        class="rename-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="renameModalTitle"
    >

        <div class="rename-modal-header">

            <div>

                <div
                    id="renameModalTitle"
                    class="rename-modal-title"
                >
                    Rename Chat
                </div>

                <div class="rename-modal-subtitle">
                    Enter a new name for this conversation.
                </div>

            </div>

            <button
                type="button"
                class="modal-close-button"
                data-action="cancel-rename"
                aria-label="Close"
            >
                ×
            </button>

        </div>


        <div class="rename-modal-body">

            <label
                for="renameChatInput"
                class="rename-input-label"
            >
                Chat name
            </label>

            <input
                id="renameChatInput"
                type="text"
                maxlength="100"
                placeholder="Enter chat name"
                autocomplete="off"
            >

        </div>


        <div class="rename-modal-footer">

            <button
                type="button"
                class="modal-button secondary"
                data-action="cancel-rename"
            >
                Cancel
            </button>

            <button
                type="button"
                class="modal-button primary"
                data-action="save-rename"
            >
                Save
            </button>

        </div>

    </div>

</div>


<script src="script.js"></script>

</body>
</html>