* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html,
body {
    width: 100%;
    height: 100%;
}

body {
    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;

    background: #ffffff;
    color: #202123;

    overflow: hidden;

    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

button,
input,
textarea {
    font: inherit;
}

button {
    border: 0;
}

button:focus-visible,
input:focus-visible,
textarea:focus-visible {
    outline: 2px solid #777;
    outline-offset: 2px;
}


/* =========================================================
   APP
========================================================= */

.app {
    width: 100%;
    height: 100vh;

    display: flex;

    background: #fff;
}


/* =========================================================
   SIDEBAR
========================================================= */

.sidebar {
    width: 285px;
    min-width: 285px;
    height: 100%;

    display: flex;
    flex-direction: column;

    background: #f7f7f8;

    border-right: 1px solid #e5e5e5;

    overflow: hidden;

    transition:
        width .2s ease,
        min-width .2s ease;
}

.sidebar.collapsed {
    width: 0;
    min-width: 0;
    border-right: 0;
}

.sidebar.collapsed > * {
    opacity: 0;
    pointer-events: none;
}

.sidebar-header {
    padding: 18px 16px 14px;
    flex-shrink: 0;
}

.brand {
    display: flex;
    align-items: center;

    gap: 10px;

    margin-bottom: 18px;

    padding: 0 4px;
}

.brand-icon {
    width: 34px;
    height: 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    background: #202123;
    color: #fff;

    font-size: 17px;
    font-weight: 700;
}

.brand-text {
    color: #202123;

    font-size: 18px;
    font-weight: 650;

    letter-spacing: -0.3px;
}

.new-chat-button {
    width: 100%;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 9px;

    border-radius: 9px;

    background: #fff;
    border: 1px solid #dedede;

    color: #202123;

    font-size: 14px;
    font-weight: 550;

    cursor: pointer;

    transition:
        background .15s ease,
        border-color .15s ease,
        box-shadow .15s ease;
}

.new-chat-button:hover {
    background: #f1f1f1;
    border-color: #cfcfcf;

    box-shadow:
        0 1px 2px rgba(0,0,0,.04);
}

.new-chat-icon {
    font-size: 21px;
}


/* =========================================================
   SEARCH
========================================================= */

.search-container {
    padding: 4px 16px 14px;
}

.search-box {
    height: 38px;

    display: flex;
    align-items: center;

    gap: 8px;

    padding: 0 11px;

    background: #fff;

    border: 1px solid #e1e1e1;

    border-radius: 8px;
}

.search-box:focus-within {
    border-color: #bdbdbd;

    box-shadow:
        0 0 0 2px rgba(0,0,0,.04);
}

.search-icon {
    color: #777;
    font-size: 20px;
}

.search-box input {
    width: 100%;

    border: 0;
    outline: 0;

    background: transparent;

    color: #202123;

    font-size: 13px;
}

.sidebar-navigation {
    display: grid;
    gap: 2px;
    padding: 0 10px 12px;
}

.sidebar-nav-item {
    display: flex;
    align-items: center;
    gap: 11px;
    width: 100%;
    min-height: 36px;
    padding: 0 10px;
    border-radius: 8px;
    color: #555;
    background: transparent;
    font-size: 13px;
    text-align: left;
    cursor: pointer;
}

.sidebar-nav-item:hover,
.sidebar-nav-item.active {
    color: #222;
    background: #e9e9e9;
}

.sidebar-nav-icon {
    width: 18px;
    color: #777;
    font-size: 15px;
    text-align: center;
}

.mode-tabs {
    display: flex;
    gap: 2px;
    margin-left: 8px;
    padding: 3px;
    border-radius: 8px;
    background: #f3f3f3;
}

.mode-tab {
    padding: 5px 10px;
    border-radius: 6px;
    color: #777;
    background: transparent;
    font-size: 11px;
    cursor: pointer;
}

.mode-tab.active {
    color: #222;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, .08);
    font-weight: 600;
}


/* =========================================================
   CHATS
========================================================= */

.conversation-section {
    flex: 1;

    min-height: 0;

    display: flex;
    flex-direction: column;

    overflow: hidden;
}

.conversation-section-title {
    padding: 7px 18px 8px;

    color: #8a8a8a;

    font-size: 11px;
    font-weight: 650;

    text-transform: uppercase;

    letter-spacing: .7px;
}

.conversation-list {
    flex: 1;

    min-height: 0;

    overflow-y: auto;

    padding: 2px 9px 10px;
}

.conversation-item {
    position: relative;

    min-height: 43px;

    display: flex;
    align-items: center;

    margin-bottom: 2px;

    border-radius: 8px;

    color: #3b3b3b;

    cursor: pointer;
}

.conversation-item:hover {
    background: #ececec;
}

.conversation-item.active {
    background: #e4e4e4;
    color: #171717;
}

.conversation-content {
    flex: 1;
    min-width: 0;

    padding: 11px 7px 11px 10px;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;

    font-size: 13px;
}

.conversation-actions {
    display: flex;

    align-items: center;

    gap: 1px;

    padding-right: 5px;

    opacity: 0;
}

.conversation-item:hover .conversation-actions,
.conversation-item.active .conversation-actions {
    opacity: 1;
}

.conversation-action {
    width: 28px;
    height: 28px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 6px;

    background: transparent;

    color: #777;

    cursor: pointer;
}

.conversation-action:hover {
    background: #d8d8d8;
    color: #222;
}

.conversation-action.delete:hover {
    background: #eadede;
    color: #9d3030;
}

.conversation-empty {
    padding: 22px 12px;

    text-align: center;

    color: #999;

    font-size: 12px;
}


/* =========================================================
   SIDEBAR FOOTER
========================================================= */

.sidebar-footer {
    flex-shrink: 0;

    padding: 12px;

    border-top: 1px solid #e5e5e5;
}

.sidebar-footer-item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 8px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: inherit;
    text-align: left;
    cursor: pointer;
}

.sidebar-footer-item:hover {
    background: #f3f3f3;

    padding: 7px;
}

.footer-avatar {
    width: 30px;
    height: 30px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #202123;
    color: #fff;

    font-size: 13px;
    font-weight: 650;
}

.footer-name {
    color: #333;
    font-size: 12px;
    font-weight: 600;
}

.footer-status {
    margin-top: 2px;

    color: #929292;

    font-size: 11px;
}


/* =========================================================
   MAIN
========================================================= */

.main-content {
    flex: 1;

    min-width: 0;
    min-height: 0;

    display: flex;
    flex-direction: column;

    background: #fff;
}

.chat-header {
    height: 62px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 20px;

    border-bottom: 1px solid #e5e5e5;

    background: #fff;
}

.chat-header-left,
.chat-header-right {
    display: flex;
    align-items: center;

    gap: 8px;
}

.chat-header-right .model-selector-label {
    margin-left: 8px;
}

.header-text-button {
    height: 34px;
    padding: 0 11px;
    border: 1px solid #dedede;
    border-radius: 8px;
    background: #fff;
    color: #555;
    font-size: 11px;
    cursor: pointer;
}

.header-text-button:hover {
    background: #f5f5f5;
}

.workspace-header-button {
    height: 34px;
    padding: 0 12px;
    border: 1px solid #dedede;
    border-radius: 8px;
    background: #fff;
    color: #444;
    font-size: 11px;
    cursor: pointer;
}

.workspace-header-button:hover {
    background: #f5f5f5;
}

.model-selector-label {
    color: #888;
    font-size: 11px;
}

.model-selector {
    max-width: 210px;
    height: 34px;
    padding: 0 28px 0 10px;
    border: 1px solid #ddd;
    border-radius: 8px;
    outline: none;
    background: #fff;
    color: #555;
    font-size: 11px;
    cursor: pointer;
}

.intelligence-selector {
    max-width: 130px;
}

.model-selector:focus {
    border-color: #aaa;
    box-shadow: 0 0 0 3px #f0f0f0;
}

.header-icon-button {
    width: 34px;
    height: 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 8px;

    background: #f4f4f4;

    color: #555;

    cursor: pointer;

    font-size: 18px;
}

.header-icon-button:hover {
    background: #e9e9e9;
}

.chat-title {
    max-width: 600px;

    overflow: hidden;

    white-space: nowrap;
    text-overflow: ellipsis;

    color: #222;

    font-size: 14px;
    font-weight: 500;
}

.agent-status {
    display: flex;
    align-items: center;

    gap: 8px;

    color: #777;

    font-size: 12px;
}

.status-dot {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #555;

    box-shadow:
        0 0 0 3px #eee;
}

.agent-status.working .status-dot {
    animation: statusPulse 1s infinite;
}

.agent-status.success .status-dot {
    background: #555;
}

@keyframes statusPulse {
    0%,
    100% {
        opacity: .35;
    }

    50% {
        opacity: 1;
    }
}

.workspace-header-button {
    height: 34px;

    padding: 0 12px;

    border: 1px solid #ddd;
    border-radius: 8px;

    background: #fff;

    color: #555;

    font-size: 12px;
    font-weight: 600;

    cursor: pointer;
}

.workspace-header-button:hover {
    background: #f4f4f4;
}

.control-center-modal {
    width: min(980px, calc(100vw - 32px));
    height: min(720px, calc(100vh - 32px));
    overflow: hidden;
    border: 1px solid #d9d9d9;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 20px 70px rgba(0, 0, 0, .18);
}

.control-center-body {
    height: calc(100% - 126px);
    overflow-y: auto;
    padding: 0;
}

.capability-loading,
.capability-error {
    padding: 28px;
    color: #777;
    text-align: center;
}

.capability-error {
    color: #a33;
}

.capability-summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 20px;
}

.settings-preferences {
    display: grid;
    gap: 8px;
    margin-bottom: 20px;
}

.settings-layout {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    min-height: 100%;
}

.settings-nav {
    padding: 20px 12px;
    border-right: 1px solid #e6e6e6;
    background: #fafafa;
}

.settings-nav-item {
    display: block;
    width: 100%;
    padding: 10px 12px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: #333;
    font-size: 13px;
    text-align: left;
    cursor: pointer;
}

.settings-nav-item:hover,
.settings-nav-item.active {
    background: #ececec;
    font-weight: 600;
}

.settings-content {
    min-width: 0;
    overflow-y: auto;
    padding: 28px 30px;
}

.settings-panel-section {
    display: none;
    padding-bottom: 22px;
    border-bottom: 1px solid #ededed;
}

.settings-panel-section.active {
    display: block;
}

.settings-panel-section h2 {
    margin: 0 0 7px;
    color: #202123;
    font-size: 23px;
    font-weight: 600;
}

.settings-description {
    margin: 0 0 20px;
    color: #727272;
    font-size: 13px;
    line-height: 1.5;
}

.settings-capabilities {
    padding-top: 22px;
}

.message-action-button {
    margin-top: 8px;
    padding: 3px 8px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #777;
    font-size: 11px;
    cursor: pointer;
}

.message-action-button:hover {
    background: #f0f0f0;
    color: #222;
}

.settings-preference {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 14px;
    border: 1px solid #ededed;
    border-radius: 10px;
    background: #fff;
}

.settings-preference strong,
.settings-preference small {
    display: block;
}

.project-create-form {
    display: flex;
    gap: 8px;
    align-items: center;
}

.project-create-form input {
    width: 180px;
    padding: 9px 10px;
    border: 1px solid #dedede;
    border-radius: 8px;
    color: #202123;
}

.settings-preference strong {
    color: #2c2c2c;
    font-size: 12px;
}

.settings-preference small {
    margin-top: 3px;
    color: #888;
    font-size: 11px;
}

.capability-summary > div,
.capability-card {
    padding: 12px;
    border: 1px solid #ededed;
    border-radius: 10px;
    background: #fafafa;
}

.capability-label,
.capability-card-meta {
    display: block;
    color: #888;
    font-size: 11px;
}

.capability-summary strong {
    display: block;
    margin-top: 5px;
    color: #222;
    font-size: 13px;
}

.capability-section {
    margin-top: 20px;
}

.settings-capabilities [data-settings-detail][hidden] {
    display: none !important;
}

.settings-select {
    min-width: 132px;
    padding: 8px 10px;
    border: 1px solid #dedede;
    border-radius: 8px;
    background: #fff;
    color: #202123;
}

.settings-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 14px 0;
    border-bottom: 1px solid #ededed;
    cursor: pointer;
}

.settings-toggle:last-child {
    border-bottom: 0;
}

.settings-toggle span {
    display: grid;
    gap: 4px;
}

.settings-toggle small,
.settings-preference small {
    color: #727272;
}

.settings-toggle input {
    width: 18px;
    height: 18px;
    accent-color: #10a37f;
}

.capability-section-title {
    margin-bottom: 9px;
    color: #444;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
}

.capability-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 8px;
}

.capability-card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: #333;
    font-size: 12px;
    font-weight: 600;
}

.capability-badge {
    padding: 3px 6px;
    border-radius: 999px;
    color: #8a6d1d;
    background: #fff6d7;
    font-size: 10px;
    white-space: nowrap;
}

.capability-badge.ready,
.feature-chip.enabled {
    color: #256b43;
    background: #e8f6ed;
}

.capability-list {
    overflow: hidden;
    border: 1px solid #ededed;
    border-radius: 10px;
}

.capability-scroll {
    max-height: 180px;
    overflow-y: auto;
}

.capability-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 10px;
    border-bottom: 1px solid #f0f0f0;
    color: #666;
    font-size: 11px;
}

.capability-row:last-child {
    border-bottom: 0;
}

.capability-row strong {
    color: #333;
    font-weight: 600;
    text-align: right;
}

.capability-row-actions {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
}

.capability-action-button {
    padding: 3px 8px;
    border: 1px solid #d8d8d8;
    border-radius: 6px;
    color: #444;
    background: #fff;
    font-size: 10px;
    cursor: pointer;
}

.capability-action-button:hover {
    border-color: #aaa;
    background: #f7f7f7;
}

.capability-action-button:disabled {
    cursor: wait;
    opacity: .65;
}

.capability-ready {
    color: #256b43 !important;
}

.capability-muted {
    color: #987b37 !important;
}

.feature-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.feature-chip {
    padding: 5px 8px;
    border-radius: 999px;
    color: #777;
    background: #f0f0f0;
    font-size: 10px;
}

.feature-chip.disabled {
    color: #999;
}


/* =========================================================
   WORKSPACE LAYOUT
========================================================= */

.workspace-layout {
    flex: 1;

    min-height: 0;
    min-width: 0;

    display: flex;
}

.chat-panel {
    flex: 1;

    min-width: 0;
    min-height: 0;

    display: flex;
    flex-direction: column;
}


/* =========================================================
   MESSAGES
========================================================= */

.messages {
    flex: 1;

    min-height: 0;

    overflow-y: auto;

    padding: 36px 28px 30px;

    scroll-behavior: smooth;
}

.message {
    width: 100%;
    max-width: 900px;

    margin: 0 auto 30px;
}

.message-inner {
    display: flex;
    align-items: flex-start;

    gap: 14px;
}

.message-avatar {
    width: 32px;
    height: 32px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 8px;

    background: #202123;
    color: #fff;

    font-size: 11px;
    font-weight: 650;
}

.message.user .message-avatar {
    background: #ededed;
    color: #555;
}

.message-body {
    min-width: 0;
    flex: 1;
}

.message-sender {
    margin-bottom: 6px;

    color: #555;

    font-size: 12px;
    font-weight: 650;
}

.message-content {
    color: #292929;

    font-size: 14px;

    line-height: 1.7;

    overflow-wrap: anywhere;
}

.message-content h1,
.message-content h2,
.message-content h3 {
    margin-top: 18px;
    margin-bottom: 8px;

    color: #202123;

    line-height: 1.3;
}

.message-content h1 {
    font-size: 21px;
}

.message-content h2 {
    font-size: 18px;
}

.message-content h3 {
    font-size: 16px;
}

.message-content strong {
    font-weight: 700;
    color: #202123;
}

.message-content ul,
.message-content ol {
    margin: 9px 0 12px 23px;
}

.message-content li {
    margin-bottom: 5px;
}

.message-content code {
    padding: 2px 5px;

    border-radius: 4px;

    background: #f1f1f1;

    color: #444;

    font-family:
        Consolas,
        "Courier New",
        monospace;

    font-size: .9em;
}


/* =========================================================
   CODE
========================================================= */

.code-block {
    margin: 15px 0;

    overflow: hidden;

    border: 1px solid #dedede;

    border-radius: 9px;

    background: #f7f7f7;
}

.code-header {
    height: 36px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 10px 0 13px;

    border-bottom: 1px solid #dedede;

    background: #eee;

    color: #666;

    font-family:
        Consolas,
        "Courier New",
        monospace;

    font-size: 11px;
}

.copy-code-button {
    padding: 5px 9px;

    border-radius: 5px;

    background: #fff;

    border: 1px solid #d6d6d6;

    color: #555;

    font-size: 11px;

    cursor: pointer;
}

.code-block pre {
    margin: 0;

    padding: 14px;

    overflow-x: auto;

    color: #303030;

    font-family:
        Consolas,
        "Courier New",
        monospace;

    font-size: 12px;

    line-height: 1.55;

    white-space: pre-wrap;
}


/* =========================================================
   MESSAGE ACTIONS
========================================================= */

.message-actions {
    margin-top: 10px;
}

.message-action-button {
    padding: 5px 8px;

    border-radius: 6px;

    background: transparent;

    color: #888;

    font-size: 11px;

    cursor: pointer;
}

.message-action-button:hover {
    background: #f1f1f1;
    color: #444;
}


/* =========================================================
   WELCOME
========================================================= */

.welcome-message {
    min-height: 60%;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;

    padding: 50px 20px;
}

.welcome-icon {
    width: 58px;
    height: 58px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 20px;

    border-radius: 17px;

    background: #202123;
    color: #fff;

    font-size: 26px;
    font-weight: 700;

    box-shadow:
        0 5px 20px rgba(0,0,0,.08);
}

.welcome-message h1 {
    margin-bottom: 8px;

    color: #222;

    font-size: 26px;
    font-weight: 650;
}

.welcome-message p {
    color: #888;
    font-size: 14px;
}


/* =========================================================
   THINKING
========================================================= */

.thinking-message {
    margin-bottom: 30px;
}

.thinking-indicator {
    height: 25px;

    display: flex;
    align-items: center;

    gap: 5px;
}

.thinking-indicator span {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: #777;
    box-shadow: 0 0 0 1px rgba(119, 119, 119, .08);

    animation:
        nexus-thinking 1.2s infinite ease-in-out;
}

.product-view {
    width: min(900px, 100%);
    margin: 0 auto;
    padding: 44px 28px;
}

.product-view-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
}

.product-view h1 {
    margin: 0 0 6px;
    color: #202123;
    font-size: 30px;
}

.product-view p {
    margin: 0;
    color: #707070;
    line-height: 1.55;
}

.product-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px;
    border: 1px solid #e5e5e5;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 4px 16px rgba(0, 0, 0, .04);
}

.product-card > div:nth-child(2) {
    flex: 1;
}

.product-card strong {
    display: block;
    margin-bottom: 5px;
    color: #272727;
}

.product-card-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: 10px;
    color: #fff;
    background: #202123;
    font-weight: 700;
}

.thinking-indicator span:nth-child(2) {
    animation-delay: .15s;
}

.thinking-indicator span:nth-child(3) {
    animation-delay: .3s;
}

@keyframes nexus-thinking {
    0%,
    60%,
    100% {
        opacity: .3;
        transform: translateY(0);
    }

    30% {
        opacity: 1;
        transform: translateY(-3px);
    }
}


/* =========================================================
   INPUT
========================================================= */

.input-area {
    flex-shrink: 0;

    width: 100%;

    padding:
        10px
        28px
        24px;

    background: #fff;
}

.input-wrapper {
    width: 100%;
    max-width: 900px;

    min-height: 58px;

    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    align-items: end;

    gap: 8px;

    margin: 0 auto;

    padding: 8px;

    border: 1px solid #d9d9d9;

    border-radius: 16px;

    background: #fff;

    box-shadow:
        0 1px 4px rgba(0,0,0,.06);
}

#messageInput {
    grid-column: 1 / -1;
    grid-row: 1;

    min-width: 0;

    min-height: 38px;
    max-height: 180px;

    resize: none;

    border: 0;
    outline: 0;

    padding:
        9px
        8px
        8px
        10px;

    background: transparent;

    color: #222;

    font-size: 14px;

    line-height: 1.5;
}

.send-button {
    min-width: 78px;
    height: 38px;
    grid-column: 2;
    grid-row: 2;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 7px;

    border-radius: 9px;

    background: #202123;
    color: #fff;

    font-size: 12px;
    font-weight: 600;

    cursor: pointer;
}

.composer-toolbar {
    grid-column: 1;
    grid-row: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
    padding: 3px 0 0 4px;
}

.composer-tools,
.composer-controls {
    display: flex;
    align-items: center;
    gap: 6px;
}

.composer-tools {
    position: relative;
}

.composer-icon-button,
.composer-tool-button,
.composer-select {
    height: 30px;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: #666;
    font-size: 11px;
}

.composer-icon-button {
    width: 30px;
    font-size: 20px;
    line-height: 1;
}

.composer-tool-button {
    padding: 0 8px;
    cursor: pointer;
}

.composer-tool-button:hover,
.composer-tool-button.active,
.composer-icon-button:hover {
    border-color: #e0e0e0;
    background: #f5f5f5;
    color: #222;
}

.voice-button.active {
    border-color: #d7a0a0;
    color: #a23d3d;
    background: #fff1f1;
}

.attachment-menu {
    position: absolute;
    z-index: 80;
    bottom: 42px;
    left: 0;
    display: grid;
    min-width: 220px;
    padding: 6px;
    border: 1px solid #ddd;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(0, 0, 0, .14);
}

.attachment-menu button {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 10px;
    border-radius: 7px;
    color: #444;
    background: transparent;
    font-size: 12px;
    text-align: left;
    cursor: pointer;
}

.attachment-menu button:hover {
    background: #f3f3f3;
}

.composer-notice {
    position: fixed;
    z-index: 100;
    right: 20px;
    bottom: 20px;
    max-width: 360px;
    padding: 12px 14px;
    border: 1px solid #ddd;
    border-radius: 9px;
    color: #333;
    background: #fff;
    box-shadow: 0 6px 22px rgba(0, 0, 0, .14);
    font-size: 12px;
}

.composer-select {
    max-width: 150px;
    padding: 0 22px 0 7px;
    border-color: #e0e0e0;
    background: #fff;
    cursor: pointer;
}

.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

.sidebar-toggle {
    background: transparent;
}

.sidebar-toggle:hover {
    background: #f1f1f1;
}

@media (max-width: 700px) {
    .sidebar.collapsed {
        width: 0;
        min-width: 0;
    }

    .sidebar:not(.collapsed) {
        position: absolute;
        inset: 0 auto 0 0;
        z-index: 70;
        width: min(300px, 86vw);
        min-width: min(300px, 86vw);
        box-shadow: 12px 0 32px rgba(0, 0, 0, .16);
    }

    .sidebar:not(.collapsed) > * {
        opacity: 1;
        pointer-events: auto;
    }

    .sidebar-toggle {
        display: flex;
    }
}

.send-button:hover {
    background: #000;
}

.send-button-icon {
    font-size: 16px;
}

.input-hint {
    max-width: 900px;

    margin: 8px auto 0;

    text-align: center;

    color: #999;

    font-size: 10px;
}

.hint-separator {
    margin: 0 5px;
    color: #c2c2c2;
}


/* =========================================================
   WORKSPACE PANEL
========================================================= */

.workspace-panel {
    width: 390px;
    min-width: 390px;

    height: 100%;

    display: flex;
    flex-direction: column;

    background: #fafafa;

    border-left: 1px solid #e6e6e6;

    overflow-y: auto;

    transition:
        width .2s ease,
        min-width .2s ease;
}

.workspace-panel[hidden] {
    display: none !important;
}

.workspace-panel.closed {
    width: 0;
    min-width: 0;

    border-left: 0;

    overflow: hidden;
}

.workspace-header {
    min-height: 68px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 10px;

    padding: 13px 15px;

    background: #fff;

    border-bottom: 1px solid #e8e8e8;

    flex-shrink: 0;
}

.workspace-tabs {
    display: flex;
    gap: 4px;
    padding: 8px 14px;
    border-bottom: 1px solid #ededed;
    background: #fff;
}

.workspace-tab {
    padding: 6px 9px;
    border-radius: 7px;
    color: #777;
    background: transparent;
    font-size: 11px;
    cursor: pointer;
}

.workspace-tab:hover {
    background: #f5f5f5;
    color: #444;
}

.workspace-tab.active {
    color: #222;
    background: #f0f0f0;
    font-weight: 600;
}

.workspace-title {
    color: #222;

    font-size: 14px;
    font-weight: 700;
}

.workspace-subtitle {
    max-width: 300px;

    margin-top: 3px;

    overflow: hidden;

    white-space: nowrap;
    text-overflow: ellipsis;

    color: #999;

    font-family:
        Consolas,
        monospace;

    font-size: 9px;
}

.workspace-close {
    width: 30px;
    height: 30px;

    border-radius: 7px;

    background: transparent;

    color: #777;

    font-size: 20px;

    cursor: pointer;
}

.workspace-close:hover {
    background: #eee;
}


/* =========================================================
   WORKSPACE SECTIONS
========================================================= */

.workspace-section {
    padding: 13px 14px;

    border-bottom: 1px solid #e8e8e8;
}

.workspace-section-header {
    min-height: 24px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    color: #555;

    font-size: 11px;
    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: .5px;
}

.activity-state,
.file-count {
    color: #aaa;

    font-size: 9px;
    font-weight: 600;

    text-transform: none;
}


/* =========================================================
   ACTIVITY
========================================================= */

.agent-activity {
    margin-top: 9px;
}

.activity-empty {
    padding: 10px;

    border: 1px dashed #ddd;

    border-radius: 8px;

    color: #999;

    font-size: 10px;

    line-height: 1.5;
}

.activity-item {
    position: relative;

    display: flex;

    gap: 9px;

    padding: 7px 0;
}

.activity-icon {
    width: 20px;
    height: 20px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 50%;

    background: #ededed;

    color: #555;

    font-size: 9px;
}

.activity-item.active .activity-icon {
    animation:
        activityPulse 1.2s infinite;
}

.activity-item.completed .activity-icon {
    background: #ddd;
}

.activity-text {
    min-width: 0;

    color: #555;

    font-size: 10px;

    line-height: 1.45;
}

.activity-time {
    display: block;

    margin-top: 2px;

    color: #aaa;

    font-size: 8px;
}

@keyframes activityPulse {
    0%,
    100% {
        opacity: .4;
    }

    50% {
        opacity: 1;
    }
}


/* =========================================================
   PROJECT
========================================================= */

.project-info {
    margin-top: 9px;
}

.project-card {
    padding: 10px;

    border: 1px solid #e2e2e2;

    border-radius: 9px;

    background: #fff;
}

.project-name {
    color: #333;

    font-size: 12px;
    font-weight: 700;
}

.project-type {
    margin-top: 3px;

    color: #999;

    font-size: 9px;
}

.project-meta {
    display: flex;

    gap: 6px;

    margin-top: 8px;

    flex-wrap: wrap;
}

.project-tag {
    padding: 3px 6px;

    border-radius: 5px;

    background: #f1f1f1;

    color: #777;

    font-size: 8px;
}

.project-empty {
    padding: 9px;

    color: #aaa;

    font-size: 10px;
}


/* =========================================================
   FILE TREE
========================================================= */

.workspace-files-section {
    min-height: 150px;
}

.workspace-tree {
    margin-top: 8px;

    max-height: 280px;

    overflow-y: auto;
}

.tree-empty {
    padding: 10px;

    color: #aaa;

    font-size: 10px;
}

.tree-item {
    min-height: 29px;

    display: flex;
    align-items: center;

    gap: 7px;

    padding: 0 7px;

    border-radius: 6px;

    color: #555;

    cursor: pointer;
}

.tree-item:hover {
    background: #eee;
}

.tree-item.selected {
    background: #e3e3e3;
    color: #222;
}

.tree-icon {
    width: 18px;

    color: #888;

    text-align: center;

    font-size: 10px;
}

.tree-name {
    min-width: 0;

    overflow: hidden;

    white-space: nowrap;
    text-overflow: ellipsis;

    font-family:
        Consolas,
        monospace;

    font-size: 10px;
}

.tree-folder {
    font-weight: 600;
}

.tree-children {
    padding-left: 15px;
}


/* =========================================================
   EDITOR
========================================================= */

.file-editor-section {
    min-height: 250px;
}

.hidden {
    display: none !important;
}

.editor-actions,
.preview-actions {
    display: flex;
    align-items: center;

    gap: 4px;
}

.small-action-button {
    min-width: 26px;
    height: 25px;

    padding: 0 7px;

    border: 1px solid #ddd;

    border-radius: 5px;

    background: #fff;

    color: #666;

    font-size: 9px;
    font-weight: 600;

    cursor: pointer;
}

.small-action-button:hover {
    background: #eee;
    color: #333;
}

.file-editor {
    width: 100%;

    height: 240px;

    margin-top: 8px;

    resize: vertical;

    padding: 10px;

    border: 1px solid #ddd;

    border-radius: 8px;

    outline: 0;

    background: #fff;

    color: #333;

    font-family:
        Consolas,
        "Courier New",
        monospace;

    font-size: 10px;

    line-height: 1.55;

    tab-size: 2;
}


/* =========================================================
   PREVIEW
========================================================= */

.preview-container {
    position: relative;

    width: 100%;

    height: 230px;

    margin-top: 9px;

    overflow: hidden;

    border: 1px solid #ddd;

    border-radius: 9px;

    background: #fff;
}

.preview-container iframe {
    width: 100%;
    height: 100%;

    border: 0;

    background: #fff;
}

.preview-placeholder {
    height: 100%;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding: 20px;

    text-align: center;
}

.preview-icon {
    width: 35px;
    height: 35px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 9px;

    border-radius: 10px;

    background: #f0f0f0;

    color: #666;

    font-size: 16px;
}

.preview-title {
    color: #555;

    font-size: 11px;
    font-weight: 650;
}

.preview-description {
    max-width: 230px;

    margin-top: 5px;

    color: #aaa;

    font-size: 9px;

    line-height: 1.45;
}


/* =========================================================
   VERIFICATION
========================================================= */

.verification-panel {
    margin-top: 8px;
}

.verification-empty {
    padding: 9px;

    color: #aaa;

    font-size: 10px;
}

.verification-result {
    padding: 9px;

    border: 1px solid #ddd;

    border-radius: 8px;

    background: #fff;
}

.verification-result.success {
    border-color: #ccc;
}

.verification-result.error {
    border-color: #c9aaaa;
}

.verification-title {
    color: #555;

    font-size: 10px;
    font-weight: 700;
}

.verification-details {
    margin-top: 5px;

    color: #888;

    font-size: 9px;

    line-height: 1.5;
}

.verification-item {
    padding: 2px 0;
}


/* =========================================================
   TOAST
========================================================= */

.nexus-toast {
    position: fixed;

    left: 50%;
    bottom: 28px;

    z-index: 1000;

    transform: translateX(-50%);

    max-width: min(
        420px,
        calc(100vw - 32px)
    );

    padding: 11px 16px;

    border-radius: 8px;

    background: #202123;
    color: #fff;

    box-shadow:
        0 8px 25px rgba(0,0,0,.18);

    font-size: 12px;
}

.nexus-toast.error {
    background: #8b2f2f;
}


/* =========================================================
   RENAME MODAL
========================================================= */

.modal-overlay {
    position: fixed;
    inset: 0;

    z-index: 900;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(0,0,0,.35);

    opacity: 0;
    visibility: hidden;

    pointer-events: none;

    transition:
        opacity .18s ease,
        visibility .18s ease;
}

.modal-overlay.open {
    opacity: 1;
    visibility: visible;

    pointer-events: auto;
}

.rename-modal {
    width: 100%;
    max-width: 430px;

    overflow: hidden;

    border: 1px solid #dedede;

    border-radius: 13px;

    background: #fff;

    box-shadow:
        0 18px 50px rgba(0,0,0,.18);
}

.rename-modal-header {
    display: flex;
    justify-content: space-between;

    padding: 19px 20px 15px;

    border-bottom: 1px solid #eee;
}

.rename-modal-title {
    color: #202123;

    font-size: 15px;
    font-weight: 650;
}

.rename-modal-subtitle {
    margin-top: 4px;

    color: #888;

    font-size: 11px;
}

.modal-close-button {
    width: 30px;
    height: 30px;

    border-radius: 7px;

    background: transparent;

    color: #777;

    font-size: 21px;

    cursor: pointer;
}

.rename-modal-body {
    padding: 18px 20px 20px;
}

.rename-input-label {
    display: block;

    margin-bottom: 7px;

    color: #555;

    font-size: 11px;
    font-weight: 600;
}

.rename-modal-body input {
    width: 100%;
    height: 42px;

    padding: 0 11px;

    border: 1px solid #d6d6d6;

    border-radius: 8px;

    outline: 0;

    font-size: 13px;
}

.rename-modal-footer {
    display: flex;
    justify-content: flex-end;

    gap: 8px;

    padding: 13px 20px;

    border-top: 1px solid #eee;

    background: #fafafa;
}

.modal-button {
    min-width: 74px;
    height: 36px;

    padding: 0 13px;

    border-radius: 7px;

    font-size: 12px;
    font-weight: 600;

    cursor: pointer;
}

.modal-button.secondary {
    background: #fff;
    border: 1px solid #d8d8d8;
    color: #555;
}

.modal-button.primary {
    background: #202123;
    color: #fff;
}


/* =========================================================
   SCROLLBARS
========================================================= */

* {
    scrollbar-width: thin;
    scrollbar-color: #c8c8c8 transparent;
}

::-webkit-scrollbar {
    width: 7px;
    height: 7px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    background: #c8c8c8;
    border-radius: 10px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1150px) {

    .workspace-panel {
        width: 330px;
        min-width: 330px;
    }

}

@media (max-width: 900px) {

    .sidebar {
        width: 245px;
        min-width: 245px;
    }

    .workspace-panel {
        width: 310px;
        min-width: 310px;
    }

    .chat-header {
        padding: 0 15px;
    }

    .chat-header-right .model-selector-label {
        margin-left: 8px;
    }

    .workspace-header-button,
    .chat-header-right .workspace-header-button {
        height: 34px;
        padding: 0 12px;
        border: 1px solid #dedede;
        border-radius: 8px;
        background: #fff;
        color: #444;
        font-size: 11px;
        cursor: pointer;
    }

    .workspace-header-button:hover {
        background: #f5f5f5;
    }

    .messages {
        padding: 28px 20px 25px;
    }

    .input-area {
        padding: 10px 20px 18px;
    }

}

@media (max-width: 700px) {

    .model-selector-label {
        display: none;
    }

    .model-selector {
        max-width: 130px;
    }

    .workspace-panel {
        position: absolute;

        top: 62px;
        right: 0;
        bottom: 0;

        z-index: 50;

        width: min(390px, 92vw);
        min-width: min(390px, 92vw);

        box-shadow:
            -10px 0 30px rgba(0,0,0,.12);
    }

    .workspace-panel.closed {
        width: 0;
        min-width: 0;
    }

    .workspace-header-button {
        display: none;
    }

    .sidebar {
        width: 72px;
        min-width: 72px;
    }

    .brand {
        justify-content: center;
    }

    .brand-text {
        display: none;
    }

    .new-chat-button {
        width: 42px;
        margin: auto;
        padding: 0;
    }

    .new-chat-button span:not(.new-chat-icon) {
        display: none;
    }

    .search-box {
        width: 42px;
        margin: auto;
        padding: 0;
        justify-content: center;
    }

    .search-box input {
        display: none;
    }

    .conversation-section-title,
    .footer-info {
        display: none;
    }

    .conversation-content {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 0;

        font-size: 0;
    }

    .conversation-content::before {
        content: "N";

        width: 27px;
        height: 27px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 7px;

        background: #e1e1e1;

        color: #666;

        font-size: 11px;
        font-weight: 700;
    }

    .conversation-item.active .conversation-content::before {
        background: #202123;
        color: #fff;
    }

    .conversation-actions {
        display: none;
    }

    .chat-header {
        height: 56px;
    }

    .connection-status {
        display: none;
    }

    .messages {
        padding: 22px 15px 20px;
    }

    .message {
        margin-bottom: 24px;
    }

    .message-inner {
        gap: 10px;
    }

    .message-avatar {
        width: 29px;
        height: 29px;
    }

    .message-content {
        font-size: 13px;
    }

    .welcome-message h1 {
        font-size: 21px;
    }

    .input-area {
        padding: 7px 10px 13px;
    }

    .input-wrapper {
        min-height: 51px;
        border-radius: 12px;
        padding: 6px;
    }

    .send-button {
        min-width: 40px;
        width: 40px;
        height: 37px;
    }

    .send-button-text {
        display: none;
    }

}

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
    }

}

::selection {
    background: #dcdcdc;
    color: #111;
}