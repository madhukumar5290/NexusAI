                        <div class="settings-preference"><label for="advancedMaxTokens"><strong>Output budget</strong><small>64 to 32,768 tokens.</small></label><input id="advancedMaxTokens" class="settings-select" type="number" min="64" max="32768" step="64"></div>
                        <div class="settings-preference"><label for="advancedMaxSteps"><strong>Agent steps</strong><small>Bounded by the Nexus runtime limit.</small></label><input id="advancedMaxSteps" class="settings-select" type="number" min="1" max="12" step="1"></div>
