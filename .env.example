# Nexus AI provider configuration.
# Copy this file to .env and fill only the providers you intend to use.
# Secrets stay on the server and are never sent to the browser.

# Account creation is disabled until chats/files/memory are isolated per user.
# These variables remain for deployments that already define them but cannot
# enable signup in this build.
NEXUS_ALLOW_SIGNUP=false
NEXUS_SIGNUP_INVITE_CODE=
# Set these to enable email verification and password recovery.
# In production, NEXUS_PUBLIC_URL must be the public HTTPS origin.
NEXUS_REQUIRE_EMAIL_VERIFICATION=false
NEXUS_PUBLIC_URL=http://127.0.0.1:3000
RESEND_API_KEY=
NEXUS_EMAIL_FROM=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Used by the image_generate tool when OPENAI_API_KEY is configured.
NEXUS_IMAGE_MODEL=gpt-image-2
NEXUS_CHAT_PROVIDER=ollama
NEXUS_CHAT_MODEL=qwen2.5:1.5b
NEXUS_WRITING_PROVIDER=ollama
NEXUS_WRITING_MODEL=qwen2.5:1.5b
NEXUS_CODE_PROVIDER=ollama
NEXUS_CODE_MODEL=qwen2.5-coder:1.5b
NEXUS_PLANNER_PROVIDER=ollama
NEXUS_PLANNER_MODEL=qwen2.5-coder:1.5b
NEXUS_TTS_MODEL=gpt-4o-mini-tts
NEXUS_TRANSCRIBE_MODEL=gpt-transcribe
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
# Google login is separate from Gemini model access. Configure a Google OAuth
# web client and allow only explicitly trusted email addresses.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NEXUS_GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback
NEXUS_GOOGLE_ADMIN_EMAIL=
NEXUS_GOOGLE_ALLOWED_EMAILS=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

# Set to true to require one-time approval for risky tools.
NEXUS_REQUIRE_APPROVALS=true
